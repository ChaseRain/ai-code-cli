{"ts":"2026-06-27T08:07:16.616Z","kind":"tool_call","payload":{"id":"call_00_lG96xRIJeaIGUE52saUZ2547","name":"write_file","args":{"content":"<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>贪吃蛇</title>\n    <style>\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        body {\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            min-height: 100vh;\n            background: #1a1a2e;\n            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\n        }\n\n        .game-container {\n            text-align: center;\n            background: #16213e;\n            padding: 24px;\n            border-radius: 16px;\n            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);\n        }\n\n        .header {\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n            margin-bottom: 16px;\n            color: #eee;\n            font-size: 18px;\n        }\n\n        .score {\n            background: #e94560;\n            padding: 8px 20px;\n            border-radius: 20px;\n            font-weight: bold;\n        }\n\n        .best {\n            color: #f0a500;\n            font-weight: bold;\n        }\n\n        canvas {\n            display: block;\n            border: 2px solid #0f3460;\n            border-radius: 4px;\n            background: #0f3460;\n        }\n\n        .controls {\n            margin-top: 16px;\n            color: #aaa;\n            font-size: 14px;\n        }\n\n        .game-over-overlay {\n            display: none;\n            position: absolute;\n            top: 50%;\n            left: 50%;\n            transform: translate(-50%, -50%);\n            color: #fff;\n            font-size: 32px;\n            font-weight: bold;\n            text-shadow: 0 0 10px rgba(233, 69, 96, 0.8);\n            pointer-events: none;\n        }\n\n        .btn {\n            margin-top: 12px;\n            padding: 10px 28px;\n            font-size: 16px;\n            background: #e94560;\n            color: #fff;\n            border: none;\n            border-radius: 24px;\n            cursor: pointer;\n            font-weight: bold;\n            transition: background 0.2s;\n        }\n        .btn:hover {\n            background: #c73650;\n        }\n    </style>\n</head>\n<body>\n    <div class=\"game-container\">\n        <div class=\"header\">\n            <span>🐍 贪吃蛇</span>\n            <span class=\"score\">得分: <span id=\"score\">0</span></span>\n            <span class=\"best\">🏆 最高: <span id=\"best\">0</span></span>\n        </div>\n        <div style=\"position: relative; display: inline-block;\">\n            <canvas id=\"canvas\" width=\"400\" height=\"400\"></canvas>\n            <div class=\"game-over-overlay\" id=\"gameOverOverlay\">游戏结束</div>\n        </div>\n        <button class=\"btn\" id=\"restartBtn\">重新开始</button>\n        <div class=\"controls\">\n            ↑ ↓ ← → 或 W A S D 控制方向 | 空格暂停\n        </div>\n    </div>\n\n    <script>\n        const canvas = document.getElementById('canvas');\n        const ctx = canvas.getContext('2d');\n        const scoreEl = document.getElementById('score');\n        const bestEl = document.getElementById('best');\n        const gameOverOverlay = document.getElementById('gameOverOverlay');\n        const restartBtn = document.getElementById('restartBtn');\n\n        // 游戏配置\n        const GRID_SIZE = 20;\n        const COLS = canvas.width / GRID_SIZE;   // 20\n        const ROWS = canvas.height / GRID_SIZE;  // 20\n        const BASE_SPEED = 120; // ms/帧\n\n        // 游戏状态\n        let snake = [];\n        let food = {};\n        let direction = { x: 1, y: 0 };\n        let nextDirection = { x: 1, y: 0 };\n        let score = 0;\n        let bestScore = 0;\n        let gameLoop = null;\n        let paused = false;\n        let gameOver = false;\n        let speed = BASE_SPEED;\n\n        // 加载最高分\n        bestScore = parseInt(localStorage.getItem('snakeBest') || '0');\n        bestEl.textContent = bestScore;\n\n        function initGame() {\n            // 初始蛇：3 节，水平居中偏左\n            const startX = Math.floor(COLS / 2);\n            const startY = Math.floor(ROWS / 2);\n            snake = [\n                { x: startX, y: startY },\n                { x: startX - 1, y: startY },\n                { x: startX - 2, y: startY },\n            ];\n            direction = { x: 1, y: 0 };\n            nextDirection = { x: 1, y: 0 };\n            score = 0;\n            speed = BASE_SPEED;\n            paused = false;\n            gameOver = false;\n            scoreEl.textContent = '0';\n            gameOverOverlay.style.display = 'none';\n            spawnFood();\n            startLoop();\n        }\n\n        function spawnFood() {\n            // 收集蛇占据的位置\n            const occupied = new Set(snake.map(s => `${s.x},${s.y}`));\n            const free = [];\n            for (let x = 0; x < COLS; x++) {\n                for (let y = 0; y < ROWS; y++) {\n                    if (!occupied.has(`${x},${y}`)) {\n                        free.push({ x, y });\n                    }\n                }\n            }\n            if (free.length === 0) {\n                // 赢了！\n                gameOver = true;\n                return;\n            }\n            food = free[Math.floor(Math.random() * free.length)];\n        }\n\n        function update() {\n            if (paused || gameOver) return;\n\n            // 更新方向\n            direction = { ...nextDirection };\n\n            // 新头部\n            const head = {\n                x: snake[0].x + direction.x,\n                y: snake[0].y + direction.y,\n            };\n\n            // 穿墙 / 撞到自己\n            const hitWall = head.x < 0 || head.x >= COLS || head.y < 0 || head.y >= ROWS;\n            const hitSelf = snake.some(s => s.x === head.x && s.y === head.y);\n\n            if (hitWall || hitSelf) {\n                endGame();\n                return;\n            }\n\n            snake.unshift(head);\n\n            // 吃到食物\n            if (head.x === food.x && head.y === food.y) {\n                score += 10;\n                scoreEl.textContent = score;\n                // 加速\n                speed = Math.max(50, BASE_SPEED - score);\n                spawnFood();\n                if (gameOver) {\n                    // 满了\n                    endGame();\n                    return;\n                }\n            } else {\n                snake.pop();\n            }\n\n            restartLoop();\n        }\n\n        function draw() {\n            // 清屏\n            ctx.fillStyle = '#0f3460';\n            ctx.fillRect(0, 0, canvas.width, canvas.height);\n\n            // 画网格线\n            ctx.strokeStyle = 'rgba(255,255,255,0.04)';\n            ctx.lineWidth = 0.5;\n            for (let x = 0; x <= COLS; x++) {\n                ctx.beginPath();\n                ctx.moveTo(x * GRID_SIZE, 0);\n                ctx.lineTo(x * GRID_SIZE, canvas.height);\n                ctx.stroke();\n            }\n            for (let y = 0; y <= ROWS; y++) {\n                ctx.beginPath();\n                ctx.moveTo(0, y * GRID_SIZE);\n                ctx.lineTo(canvas.width, y * GRID_SIZE);\n                ctx.stroke();\n            }\n\n            // 画食物\n            ctx.fillStyle = '#e94560';\n            ctx.shadowColor = '#e94560';\n            ctx.shadowBlur = 8;\n            ctx.beginPath();\n            ctx.arc(\n                food.x * GRID_SIZE + GRID_SIZE / 2,\n                food.y * GRID_SIZE + GRID_SIZE / 2,\n                GRID_SIZE / 2 - 2,\n                0,\n                Math.PI * 2\n            );\n            ctx.fill();\n            ctx.shadowBlur = 0;\n\n            // 画蛇\n            snake.forEach((seg, i) => {\n                const alpha = 1 - i * 0.03;\n                ctx.fillStyle = i === 0\n                    ? '#00d2ff'  // 蛇头\n                    : `rgba(0, 210, 255, ${Math.max(alpha, 0.3)})`;\n                const padding = i === 0 ? 1 : 2;\n                ctx.fillRect(\n                    seg.x * GRID_SIZE + padding,\n                    seg.y * GRID_SIZE + padding,\n                    GRID_SIZE - padding * 2,\n                    GRID_SIZE - padding * 2\n                );\n\n                // 蛇头眼睛\n                if (i === 0) {\n                    ctx.fillStyle = '#fff';\n                    const cx = seg.x * GRID_SIZE + GRID_SIZE / 2;\n                    const cy = seg.y * GRID_SIZE + GRID_SIZE / 2;\n                    const eyeR = 3;\n                    let ex1, ey1, ex2, ey2;\n                    if (direction.x === 1) { // 右\n                        ex1 = cx + 4; ey1 = cy - 3;\n                        ex2 = cx + 4; ey2 = cy + 3;\n                    } else if (direction.x === -1) { // 左\n                        ex1 = cx - 4; ey1 = cy - 3;\n                        ex2 = cx - 4; ey2 = cy + 3;\n                    } else if (direction.y === -1) { // 上\n                        ex1 = cx - 3; ey1 = cy - 4;\n                        ex2 = cx + 3; ey2 = cy - 4;\n                    } else { // 下\n                        ex1 = cx - 3; ey1 = cy + 4;\n                        ex2 = cx + 3; ey2 = cy + 4;\n                    }\n                    ctx.beginPath();\n                    ctx.arc(ex1, ey1, eyeR, 0, Math.PI * 2);\n                    ctx.fill();\n                    ctx.beginPath();\n                    ctx.arc(ex2, ey2, eyeR, 0, Math.PI * 2);\n                    ctx.fill();\n                }\n            });\n        }\n\n        function gameStep() {\n            update();\n            draw();\n        }\n\n        function startLoop() {\n            stopLoop();\n            gameLoop = setInterval(gameStep, speed);\n        }\n\n        function restartLoop() {\n            stopLoop();\n            gameLoop = setInterval(gameStep, speed);\n        }\n\n        function stopLoop() {\n            if (gameLoop) {\n                clearInterval(gameLoop);\n                gameLoop = null;\n            }\n        }\n\n        function endGame() {\n            gameOver = true;\n            stopLoop();\n            gameOverOverlay.style.display = 'block';\n            // 更新最高分\n            if (score > bestScore) {\n                bestScore = score;\n                bestEl.textContent = bestScore;\n                localStorage.setItem('snakeBest', bestScore);\n            }\n        }\n\n        // 键盘控制\n        document.addEventListener('keydown', (e) => {\n            const key = e.key.toLowerCase();\n\n            if (key === ' ' || key === 'spacebar') {\n                e.preventDefault();\n                if (gameOver) return;\n                paused = !paused;\n                return;\n            }\n\n            if (paused || gameOver) return;\n\n            switch (key) {\n                case 'arrowup':\n                case 'w':\n                    if (direction.y !== 1) nextDirection = { x: 0, y: -1 };\n                    break;\n                case 'arrowdown':\n                case 's':\n                    if (direction.y !== -1) nextDirection = { x: 0, y: 1 };\n                    break;\n                case 'arrowleft':\n                case 'a':\n                    if (direction.x !== 1) nextDirection = { x: -1, y: 0 };\n                    break;\n                case 'arrowright':\n                case 'd':\n                    if (direction.x !== -1) nextDirection = { x: 1, y: 0 };\n                    break;\n            }\n        });\n\n        restartBtn.addEventListener('click', () => {\n            stopLoop();\n            initGame();\n        });\n\n        // 启动\n        initGame();\n    </script>\n</body>\n</html>\n","path":"snake.html"}}}
