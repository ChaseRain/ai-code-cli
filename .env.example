# 复制为 .env 并填入你的 Coding Plan API Key（Anthropic 协议）
#
# 注意：当前 loadConfig 只从环境变量读取 *密钥*（ANTHROPIC_AUTH_TOKEN / CODEPLAN_API_KEY）。
# 下面的 BASE_URL / MODEL 暂不会被读取（spec「不做（首期）：环境变量覆盖全部字段」）。
# 想改 baseURL / model，请写到 .ai-code-cli/config.json（见 config.example.json）。
ANTHROPIC_AUTH_TOKEN=your_api_key_here

# 以下两行仅作记录，暂不生效（baseURL/model 实际取自 DEFAULTS 或 config.json）：
ANTHROPIC_BASE_URL=https://ai-kas.kso.net/codeplan/anthropic
ANTHROPIC_MODEL=deepseek/deepseek-v4-pro
